# SDANet — Chikusei ×4 Hyperspectral Image Super-Resolution

name: SDANetRegionalContinue66K_spatial_split
model_type: SDAModel
scale: 4
num_gpu: 1
manual_seed: 10

# ============================================================
# DATASETS
# ============================================================
datasets:
  train:
    name: Chikusei
    type: PairedMatDataset8xAug
    dataroot_gt: ../datasets/Chikusei_x4_sspsr_spatial_split/trains
    io_backend:
      type: disk
    gt_size: 128
    use_hflip: true
    use_rot: true
    use_shuffle: true
    num_worker_per_gpu: 8
    batch_size_per_gpu: 16
    dataset_enlarge_ratio: 1
    prefetch_mode: ~

  # Validation only — held-out test scenes are excluded.
  val_1:
    name: Chikusei_eval
    type: PairedMatDataset8xAug
    dataroot_gt: ../datasets/Chikusei_x4_sspsr_spatial_split/evals
    io_backend:
      type: disk

# ============================================================
# NETWORK
# ============================================================
network_g:
  type: SDANET_SADS
  n_feats: 128
  n_block: [2, 2, 2, 2]
  n_group: 4
  num_heads: 4
  scale: 4
  n_colors: 128
  n_lms_colors: 128
  drop_path_rate: 0.4
  expansion_ratio: 1.0
  ste_mask_tau: 0.15

# ============================================================
# CHECKPOINT PATHS
# ============================================================
path:
  pretrain_network_g: experiments/SDANetRegionalContinue66K_spatial_split/models/net_g_57000.pth
  param_key_g: params_ema
  strict_load_g: false
  resume_state: ~

# ============================================================
# TRAINING
# ============================================================
train:
  ema_decay: 0.999

  optim_g:
    type: Adam
    lr: !!float 1e-4
    weight_decay: 0
    betas: [0.9, 0.99]

  scheduler:
    type: CosineAnnealingRestartLR
    periods: [33000, 33000]
    restart_weights: [1, 1]
    eta_min: !!float 1e-7

  total_iter: 66000
  warmup_iter: -1

  pixel_opt:
    type: L1Loss
    loss_weight: 1.0
    reduction: mean

  sam_opt:
    type: SAMLoss
    loss_weight: 0.2

# ============================================================
# VALIDATION
# ============================================================
val:
  val_freq: !!float 3000
  save_img: false
  pbar: false

  metrics:
    ssim:
      type: calculate_ssim_float
      crop_border: 0
      data_range: 1

    mpsnr:
      type: calculate_mpsnr_hsi
      crop_border: 0
      data_range: 1

    sam:
      type: calculate_sam_hsi
      crop_border: 0


    ergas:
      type: calculate_ergas_hsi
      crop_border: 0

    CC:
      type: calculate_corr_hsi
      crop_border: 0

# ============================================================
# LOGGING AND CHECKPOINTS
# ============================================================
logger:
  print_freq: 100
  save_checkpoint_freq: !!float 3000
  use_tb_logger: true

  wandb:
    project: ~
    resume_id: ~

# ============================================================
# DISTRIBUTED TRAINING
# ============================================================
dist_params:
  backend: nccl
  port: 29706
